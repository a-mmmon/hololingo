rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // ADMIN ROLE HELPERS (from the admin dashboard's rules — merged
    // in here since Firestore only has one active ruleset per project;
    // the app and the admin dashboard share this same file).
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function hasAdminAccount() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminRole() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role;
    }

    // Any signed-in admin-panel account (super_admin, admin, or viewer).
    function isPanelUser() {
      return hasAdminAccount() && adminRole() in ['super_admin', 'admin', 'viewer'];
    }

    // Can manage app content (users, scans, announcements, events) but not other admins or settings.
    function isModerator() {
      return hasAdminAccount() && adminRole() in ['super_admin', 'admin'];
    }

    // Full access: manage other admins and app-wide settings.
    function isSuperAdmin() {
      return hasAdminAccount() && adminRole() == 'super_admin';
    }

    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isPanelUser());
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /users/{userId} {
      // Broader than "owner or panel user" on purpose: the app's friend
      // search (searchUsersByName) and profile lookups let any signed-in
      // user read any other user's profile doc, not just admins.
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && (request.auth.uid == userId || isModerator());
      allow delete: if isModerator();

      match /saved_words/{word} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || isPanelUser());
        allow write: if request.auth != null
          && (request.auth.uid == userId || isModerator());
      }
      match /chat_history/{msg} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || isPanelUser());
        allow write: if request.auth != null
          && (request.auth.uid == userId || isModerator());
      }
      match /streak/{day} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || isPanelUser());
        allow write: if request.auth != null
          && (request.auth.uid == userId || isModerator());
      }
      match /progress/{doc} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || isPanelUser());
        allow write: if request.auth != null
          && (request.auth.uid == userId || isModerator());
      }
      match /topic_progress/{topicId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || isPanelUser());
        allow write: if request.auth != null
          && (request.auth.uid == userId || isModerator());
      }
      match /friends/{friendId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || isPanelUser());
        allow write: if request.auth != null
          && (request.auth.uid == userId || isModerator());
      }
      match /event_invites/{inviteId} {
        allow read, write: if request.auth != null
          && (request.auth.uid == userId || isPanelUser());
      }
    }

    // Collection group queries (collectionGroup('saved_words'),
    // collectionGroup('chat_history')) need an explicit wildcard-path
    // rule — the nested rules above only cover direct reads of a known
    // user's subcollection.
    match /{path=**}/saved_words/{word} {
      allow read: if isPanelUser();
    }
    match /{path=**}/chat_history/{msg} {
      allow read: if isPanelUser();
    }

    match /friend_requests/{requestId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.from;
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to ||
        isPanelUser()
      );
      allow update: if isModerator();
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to ||
        isModerator()
      );
    }

    match /friendships/{friendshipId} {
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.users;
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.users ||
        isPanelUser()
      );
      allow delete: if request.auth != null && (
        request.auth.uid in resource.data.users ||
        isModerator()
      );
    }

    match /bonds/{bondId} {
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.users ||
        isPanelUser()
      );
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.users;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.users ||
        isModerator()
      );
    }

    match /config/{doc} {
      // Public read: feature flags (e.g. registrationEnabled) must be
      // checkable before sign-in/sign-up.
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Users can submit feedback/bug reports but cannot read, edit, or
    // delete any entry (including their own); the admin panel can read.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow read: if isPanelUser();
      allow update, delete: if false;
    }

    match /scan_history/{scanId} {
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.user_id == request.auth.uid ||
        isPanelUser()
      );
      allow update, delete: if isModerator();
    }

    // Site-wide scan counters (word -> how many times anyone has scanned
    // it), used for the Home screen's "Popular Now" list. Readable by any
    // signed-in user; writable only as a strict +1 to scan_count, so a
    // client can bump the counter but can never set it to an arbitrary
    // value.
    match /word_stats/{word} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.word == word
        && request.resource.data.scan_count == 1;
      allow update: if request.auth != null
        && request.resource.data.word == word
        && request.resource.data.scan_count == resource.data.scan_count + 1;
      allow delete: if false;
    }

    // Topic content (name, icon, color, position, word list), read by every
    // signed-in user. `create` is only open so the app's one-time seed
    // (FirestoreService.seedTopicsOnce) can populate this collection from
    // an empty database; existing topic docs can never be changed or
    // removed by a client afterward. Add/edit topics and words later
    // through the Firebase Console or admin panel, not through the app.
    match /topics/{topicId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isModerator();
    }

    match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if isModerator();

      match /targets/{targetId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    match /announcements/{announcementId} {
      allow read: if isPanelUser();
      allow write: if isModerator();
    }

    // Not written by the app yet — read-only placeholders for the admin
    // panel until those features exist. Tighten write once they do.
    match /flagged/{id} {
      allow read: if isPanelUser();
      allow write: if false;
    }

    match /subscriptions/{id} {
      allow read: if isPanelUser();
      allow write: if false;
    }

    match /words/{wordId} {
      allow read: if isPanelUser();
      allow write: if isModerator();
    }
  }
}
